# Local application and PostgreSQL configuration
SERVER_PORT=8081
DB_NAME=pos_db
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/pos_db
DB_USERNAME=pos_user
DB_PASSWORD=change_me_locally
ADMIN_EMAIL=admin@example.com
# Required for the first startup: set a password of 10–72 UTF-8 bytes.
ADMIN_PASSWORD=
# Optional second account. Set both values to create a cashier.
CASHIER_EMAIL=
CASHIER_PASSWORD=
# Creates the Figma reference product only when the product table is empty.
SEED_REFERENCE_PRODUCT=true
COOKIE_SECURE=false
